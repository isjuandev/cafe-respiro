# Frontend usa proxy /api -> backend (ver next.config.mjs)
# No necesita NEXT_PUBLIC_API_URL. Solo define BACKEND_URL donde apunta el proxy.
# Local sin Docker: por defecto http://localhost:3001
# Docker Compose: http://backend:3001
# Coolify: inyectar BACKEND_URL con la URL interna del servicio backend
BACKEND_URL=http://localhost:3001
