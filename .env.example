# PostgreSQL (usado por docker-compose)
POSTGRES_DB=caferespiro
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/caferespiro?schema=public
# Para uso dentro de docker-compose (hostname = servicio postgres)
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/caferespiro?schema=public
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000
PORT=3001
TZ=America/Bogota

# Frontend -> Backend (proxy)
# En docker-compose el frontend usa http://backend:3001 vía BACKEND_URL
# En local sin Docker usa http://localhost:3001 (default en next.config.mjs)
# No se usa NEXT_PUBLIC_API_URL para evitar rebuild en Coolify
BACKEND_URL=http://backend:3001

# Admin panel (Sprint 3) — solo backend, nunca exponer al frontend
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET=cambia-este-secreto-en-produccion-min-32-chars
JWT_EXPIRES_IN=8h

# Rate limiting votos (defensa por capas, sin Redis)
VOTE_RATE_IP_BURST_WINDOW_MS=10000
VOTE_RATE_IP_BURST_MAX=20
VOTE_RATE_IP_WINDOW_MS=60000
VOTE_RATE_IP_MAX=20
VOTE_RATE_IP_HOUR_WINDOW_MS=3600000
VOTE_RATE_IP_HOUR_MAX=60
VOTE_RATE_CONTACT_WINDOW_MS=60000
VOTE_RATE_CONTACT_MAX=5
VOTE_RATE_CONTACT_HOUR_WINDOW_MS=3600000
VOTE_RATE_CONTACT_HOUR_MAX=20

# CAPTCHA/Turnstile (opcional, deshabilitado por defecto)
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET_KEY=
CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
